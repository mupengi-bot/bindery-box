{
  "name": "bindery-box",
  "version": "0.2.0-alpha.0",
  "private": true,
  "description": "BINDERY BOX Desktop — a local AI operations desk that works on this computer under Human Gate approval.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/validate-core.mjs",
    "check:arch": "node scripts/validate-architecture.mjs",
    "check:golden": "node scripts/validate-golden-image.mjs",
    "check:rts": "node scripts/validate-rts-office.mjs",
    "check:projection": "node scripts/validate-projection.mjs",
    "check:access": "node scripts/validate-access-topology.mjs",
    "check:stack": "node scripts/validate-local-stack.mjs",
    "check:agent-ops": "node scripts/validate-agent-ops-strategy.mjs",
    "check:visual-comfort": "node scripts/validate-visual-comfort.mjs",
    "check:work-loop": "node scripts/validate-first-real-work-loop.mjs",
    "check:local-device": "node scripts/validate-local-device.mjs",
    "check:desktop-shell": "node scripts/validate-desktop-shell.mjs",
    "check:desktop-package": "node scripts/validate-desktop-package.mjs",
    "check:desktop-live-ui": "node scripts/validate-desktop-live-ui.mjs",
    "check:photobooth-local": "node scripts/validate-photobooth-local-e2e.mjs",
    "bindery:desktop-package": "npm --prefix apps/desktop run package:mac",
    "bindery:desktop": "node scripts/bindery-desktop.mjs",
    "bindery:init": "node scripts/bindery-stack.mjs init",
    "bindery:setup": "node scripts/bindery-stack.mjs setup",
    "bindery:ready": "node scripts/bindery-stack.mjs ready",
    "bindery:smoke": "node scripts/bindery-smoke.mjs",
    "bindery:up": "node scripts/bindery-stack.mjs up",
    "bindery:down": "node scripts/bindery-stack.mjs down",
    "bindery:status": "node scripts/bindery-stack.mjs status",
    "bindery:logs": "node scripts/bindery-stack.mjs logs",
    "bindery:native-setup": "node scripts/bindery-native.mjs setup",
    "bindery:native-start": "node scripts/bindery-native.mjs start",
    "bindery:native-stop": "node scripts/bindery-native.mjs stop",
    "bindery:native-status": "node scripts/bindery-native.mjs status",
    "bindery:native-smoke": "node scripts/bindery-native.mjs smoke"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.108.1",
    "clsx": "^2.1.1",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
