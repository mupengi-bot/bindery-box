# BINDERY BOX local stack defaults.
# Copy to .env.local-stack for local Docker Compose. Do not commit real values.

BINDERY_PUBLIC_URL=http://localhost:3000
BINDERY_PUBLIC_OFFICE_URL=http://localhost:8065
BINDERY_WEB_PORT=3000
BINDERY_MATTERMOST_PORT=8065
BINDERY_POSTGRES_PORT=54329

BINDERY_POSTGRES_USER=bindery
BINDERY_POSTGRES_PASSWORD=bindery_dev_password
BINDERY_DATABASE_URL=postgres://bindery:bindery_dev_password@postgres:5432/bindery
BINDERY_MATTERMOST_DATABASE_URL=postgres://bindery:bindery_dev_password@postgres:5432/mattermost?sslmode=disable&connect_timeout=10

BINDERY_STATE_TABLE=bindery_state
BINDERY_WORKSPACE_ID=default
BINDERY_SESSION_SECRET=local-dev-change-me
BINDERY_OWNER_EMAIL=owner@bindery.local
BINDERY_OWNER_PASSWORD=bindery-local-admin

# mock = record office events only. real = use Mattermost API/webhook fields below.
BINDERY_MATTERMOST_MODE=mock
BINDERY_MATTERMOST_URL=http://localhost:8065
BINDERY_MATTERMOST_TOKEN=
BINDERY_MATTERMOST_TEAM=bindery
