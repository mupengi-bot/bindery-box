{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bindery-box.local/contracts/agent-messenger-contract.json",
  "version": "0.1.0",
  "title": "BINDERY BOX Agent Runtime and Messenger Contract",
  "type": "object",
  "required": [
    "version",
    "commands",
    "events",
    "adapters"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "requiredFields",
          "surface"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "surface": {
            "enum": [
              "mission-control",
              "messenger",
              "runtime",
              "system"
            ]
          },
          "requiredFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "source",
          "projection"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "source": {
            "enum": [
              "messenger",
              "control-plane",
              "runtime",
              "policy",
              "office"
            ]
          },
          "projection": {
            "type": "array",
            "items": {
              "enum": [
                "workstream",
                "live-log",
                "messenger-thread",
                "3d-office",
                "audit"
              ]
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "required": [
        "messengerOfficeAdapter",
        "agentRuntimeAdapter"
      ],
      "properties": {
        "messengerOfficeAdapter": {
          "type": "object",
          "required": [
            "inbound",
            "outbound"
          ],
          "properties": {
            "inbound": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outbound": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "agentRuntimeAdapter": {
          "type": "object",
          "required": [
            "methods"
          ],
          "properties": {
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "commands": [
    {
      "type": "user.message.ingest",
      "surface": "messenger",
      "requiredFields": [
        "workspaceId",
        "provider",
        "channelRef",
        "senderRef",
        "text",
        "providerEventId"
      ],
      "description": "Normalize an inbound human messenger message before intent routing."
    },
    {
      "type": "task.create",
      "surface": "mission-control",
      "requiredFields": [
        "workspaceId",
        "title",
        "requestedBy"
      ],
      "description": "Create a task from Goal Composer, messenger, scheduler, or connector trigger."
    },
    {
      "type": "agent.run.enqueue",
      "surface": "runtime",
      "requiredFields": [
        "workspaceId",
        "taskId",
        "agentId",
        "requestedBy",
        "goal"
      ],
      "description": "Queue a task for a real agent runtime worker."
    },
    {
      "type": "agent.run.cancel",
      "surface": "runtime",
      "requiredFields": [
        "runId",
        "requestedBy",
        "reason"
      ],
      "description": "Cancel a queued or running agent runtime job through the Control Plane."
    },
    {
      "type": "office.message.post",
      "surface": "system",
      "requiredFields": [
        "workspaceId",
        "channelRef",
        "text",
        "correlationId"
      ],
      "description": "Post a product-safe message into the human office/messenger."
    },
    {
      "type": "agent.create",
      "surface": "mission-control",
      "requiredFields": [
        "workspaceId",
        "name",
        "role",
        "requestedBy"
      ],
      "description": "Create a public-safe demo staff member/person with lane persona and role prompt."
    },
    {
      "type": "agent.move.requested",
      "surface": "mission-control",
      "requiredFields": [
        "workspaceId",
        "agentId",
        "x",
        "z",
        "requestedBy"
      ],
      "description": "Persist an RTS-style movement command for a selected office agent."
    }
  ],
  "events": [
    {
      "type": "user.message.received",
      "source": "messenger",
      "projection": [
        "live-log",
        "audit"
      ],
      "description": "A verified inbound human message was accepted."
    },
    {
      "type": "agent.run.queued",
      "source": "control-plane",
      "projection": [
        "workstream",
        "3d-office",
        "live-log"
      ],
      "description": "An agent job entered the runtime queue."
    },
    {
      "type": "agent.run.started",
      "source": "runtime",
      "projection": [
        "workstream",
        "3d-office",
        "messenger-thread",
        "live-log"
      ],
      "description": "The runtime began executing an agent job."
    },
    {
      "type": "agent.stream.delta",
      "source": "runtime",
      "projection": [
        "live-log"
      ],
      "description": "A throttled streaming progress chunk."
    },
    {
      "type": "agent.run.completed",
      "source": "runtime",
      "projection": [
        "workstream",
        "3d-office",
        "messenger-thread",
        "live-log",
        "audit"
      ],
      "description": "The runtime completed an agent job."
    },
    {
      "type": "agent.run.cancelled",
      "source": "runtime",
      "projection": [
        "workstream",
        "3d-office",
        "messenger-thread",
        "live-log",
        "audit"
      ],
      "description": "The runtime cancelled an agent job and projected the interruption."
    },
    {
      "type": "approval.requested",
      "source": "policy",
      "projection": [
        "workstream",
        "3d-office",
        "messenger-thread",
        "live-log",
        "audit"
      ],
      "description": "Human approval is required before continuing."
    },
    {
      "type": "office.message.posted",
      "source": "office",
      "projection": [
        "live-log",
        "audit"
      ],
      "description": "A messenger post was produced from an event."
    },
    {
      "type": "agent.created",
      "source": "control-plane",
      "projection": [
        "workstream",
        "3d-office",
        "live-log",
        "audit"
      ],
      "description": "A new agent/person joined the office with safe default capabilities."
    },
    {
      "type": "task.created",
      "source": "control-plane",
      "projection": [
        "workstream",
        "3d-office",
        "messenger-thread",
        "live-log",
        "audit"
      ],
      "description": "A zone work request created a real queued task."
    },
    {
      "type": "agent.move.accepted",
      "source": "runtime",
      "projection": [
        "workstream",
        "3d-office",
        "live-log",
        "audit"
      ],
      "description": "Policy accepted a movement command and persisted the move target."
    },
    {
      "type": "agent.move.projected",
      "source": "office",
      "projection": [
        "3d-office",
        "live-log"
      ],
      "description": "The 3D office projection received the persisted agent move target."
    }
  ],
  "adapters": {
    "messengerOfficeAdapter": {
      "inbound": [
        "verifyWebhook",
        "normalizeMessage",
        "resolveIdentity",
        "emitCommand"
      ],
      "outbound": [
        "projectEvent",
        "formatThreadPost",
        "postMessage",
        "recordOfficeEvent"
      ]
    },
    "agentRuntimeAdapter": {
      "methods": [
        "enqueue",
        "cancel",
        "subscribe",
        "health"
      ]
    }
  }
}
