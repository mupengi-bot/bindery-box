# BINDERY BOX native Mac mini server defaults.
# Copy to .env.native. Do not commit real values.

BINDERY_PUBLIC_URL=http://localhost:3000
BINDERY_PUBLIC_OFFICE_URL=http://localhost:3000
BINDERY_WEB_PORT=3000
PORT=3000

# Native Postgres installed with Homebrew. The current macOS user owns the DB.
BINDERY_DATABASE_URL=postgres://localhost:5432/bindery
BINDERY_STATE_TABLE=bindery_state
BINDERY_WORKSPACE_ID=default

BINDERY_SESSION_SECRET=native-local-change-me
BINDERY_OWNER_EMAIL=owner@bindery.local
BINDERY_OWNER_PASSWORD=bindery-local-admin

# Native mode can start without Mattermost; Human Office stays internal/mock until a real Mattermost URL/token is configured.
BINDERY_MATTERMOST_MODE=mock
BINDERY_MATTERMOST_URL=
BINDERY_MATTERMOST_TOKEN=
BINDERY_MATTERMOST_TEAM=bindery
